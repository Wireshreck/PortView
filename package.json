{
  "name": "portview",
  "version": "1.2.0",
  "private": true,
  "description": "Local port scanner with a live web viewer: every open port, its name, and the process that owns it.",
  "keywords": [
    "port-scanner",
    "ports",
    "netstat",
    "localhost",
    "developer-tools",
    "diagnostics"
  ],
  "license": "MIT",
  "main": "server.js",
  "bin": {
    "portview": "server.js"
  },
  "files": [
    "server.js",
    "scanner.js",
    "services.js",
    "process-lookup.js",
    "web-detect.js",
    "port-names.js",
    "port-names.example.json",
    "launchers.js",
    "public/",
    "scripts/"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "startup": "node server.js --startup",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-startup.ps1",
    "startup:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-startup.ps1",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "lint": "node --check server.js && node --check scanner.js && node --check services.js && node --check process-lookup.js && node --check web-detect.js && node --check port-names.js && node --check launchers.js && node --check public/app.js && node --check scripts/smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ]
}
