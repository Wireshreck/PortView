# Normalise line endings so the repository looks the same on every platform.
# Files are stored with LF and checked out with LF, except the Windows batch
# files, which need CRLF to run.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Images, archives and certificates are never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.pem binary
*.key binary
*.p12 binary
*.pfx binary

# Keep the diff readable for these.
*.md text diff=markdown
*.json text
*.yml text
*.yaml text
